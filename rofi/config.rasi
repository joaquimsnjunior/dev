configuration {
  display-drun: "";
  drun-display-format: "{icon} {name}";
  font: "JetbrainsMono Nerd Fontr 15";
  modi: "drun";
  show-icons: true;
  icon-theme: "Papirus";
}

@theme "/dev/null"

* {
    bg: #1e1e1eB3;
        bg-alt: #1e1e1eB3;
    fg: #ffffff;
        fg-alt: #838383;
        background-color: @bg;
    border: 0;
    border-color: #4ebbf6;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width:            480px;     
    background-color: @bg-base;
    border:           1px;        
    border-color:     @border-color;
    padding:          0px;        
}

mainbox {
  spacing: 0px;
  children: [inputbar, listview];
}

inputbar {
  padding: 12px 16px;
  spacing: 12px;
  children: [prompt, entry];
}

element {
  background-color: transparent;
  padding: 6 10;
  spacing: 12px;
  text-color: @fg-alt;
}

element selected {
  background-color: transparent;
  text-color: @fg;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
}

element-icon {
  background-color: transparent;
  size: 30;
  padding: 0 10 0 0;
}

entry {
  padding: 12;
  text-color: @fg;
}

listview {
  columns: 1;
  lines: 6;
  padding: 10px;
  fixed-height: false;
  spacing: 2px;
}

prompt {
  enabled: true;
  padding: 12 0 0 12;
  text-color: @fg;
}